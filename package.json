{
  "name": "@kungfu-tech/workspaces",
  "homepage": "https://www.kungfu-trader.com",
  "author": {
    "name": "Kungfu Trader",
    "email": "info@kungfu.link"
  },
  "description": "Kungfu Trader Workspaces",
  "license": "Apache-2.0",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "workspaces": {
    "packages": [
      "framework/*",
      "developer/*",
      "extensions/*",
      "examples/*",
      "artifact"
    ]
  },
  "scripts": {
    "postinstall": "pnpm exec patch-package",
    "foreach": "wsrun --serial --exclude-missing --fast-exit",
    "foreach:extensions": "wsrun --serial --package '@kungfu-tech/kfx-*' --exclude-missing --fast-exit",
    "format": "wsrun --serial --exclude-missing format",
    "prebuild": "node .prebuild.js",
    "build": "pnpm run foreach build",
    "build:extensions": "pnpm run foreach:extensions build",
    "clean": "pnpm run foreach clean",
    "clean:extensions": "pnpm run foreach:extensions clean",
    "package": "pnpm run foreach package",
    "rebuild": "pnpm run clean && pnpm run build",
    "rebuild:extensions": "pnpm run clean:extensions && pnpm run build:extensions",
    "sync": "pnpm install --frozen-lockfile",
    "app": "pnpm --filter @kungfu-tech/artifact-kungfu run app",
    "cli": "pnpm --filter @kungfu-tech/artifact-kungfu run cli",
    "dev": "pnpm --filter @kungfu-tech/artifact-kungfu run dev",
    "build:app": "pnpm --filter @kungfu-tech/gui run build",
    "build:cli": "pnpm --filter @kungfu-tech/tui run build",
    "build:core": "pnpm --filter @kungfu-tech/core run build",
    "freeze": "pnpm --filter @kungfu-tech/core run freeze",
    "rebuild:core": "pnpm --filter @kungfu-tech/core run rebuild",
    "package:app": "pnpm --filter @kungfu-tech/artifact-kungfu run package",
    "verify": "node verify.js"
  },
  "dependencies": {
    "core-js": "^3.20.0",
    "dayjs": "^1.10.7",
    "lerna": "^9.0.0",
    "wsrun": "^5.2.0"
  },
  "resolutions": {
    "vue": "~3.2.0",
    "pinia": "~2.0.0",
    "prettier": "~2.7.0",
    "ansi-regex": "^5.0.1",
    "async": "^3.2.2",
    "axios": "^0.21.1",
    "core-js": "^3.20.0",
    "highlight.js": "^11.0.0",
    "lodash.merge": "^4.6.2",
    "node-fetch": "^2.6.7",
    "node-forge": "^1.3.0",
    "node-gyp": "^9.0.0",
    "rxjs": "^7.5.0",
    "dayjs": "^1.10.7",
    "minimist": "^1.2.6",
    "uuid": "^7.0.0",
    "fs-extra": "^10.1.0",
    "nanopop": "~2.3.0",
    "@vue/babel-plugin-jsx": "~1.1.0",
    "@vue/compiler-sfc": "~3.2.4",
    "@vueuse/core": ">=10.9.0 <10.10.0",
    "@vercel/webpack-asset-relocator-loader": "<1.7.4"
  },
  "devDependencies": {
    "patch-package": "^8.0.0"
  }
}
