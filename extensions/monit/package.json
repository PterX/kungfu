{
  "name": "@kungfu-trader/kfx-broker-monit",
  "author": {
    "name": "Kungfu Trader",
    "email": "info@kungfu.link"
  },
  "version": "2.7.5-alpha.21",
  "description": "Kungfu Extension - monit",
  "license": "Apache-2.0",
  "main": "package.json",
  "repository": {
    "url": "https://github.com/kungfu-trader/kungfu.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "binary": {             
    "module_name": "kfx-broker-monit",
    "module_path": "dist/monit",
    "remote_path": "{module_name}/v{major}/v{version}",
    "package_name": "{module_name}-v{version}-{platform}-{arch}-{configuration}.tar.gz",
    "host": "https://prebuilt.libkungfu.cc"
  },
  "scripts": {
    "build": "kfs extension build",
    "clean": "kfs extension clean",
    "format": "node ../../node_modules/@kungfu-trader/kungfu-core/.gyp/run-format-cpp.js src",
    "install": "node -e \"require('@kungfu-trader/kungfu-core').prebuilt('install')\"",
    "package": "kfs extension package"
  },
  "dependencies": {
    "@kungfu-trader/kungfu-core": "^2.7.5-alpha.21"
  },
  "devDependencies": {
    "@kungfu-trader/kungfu-cli": "^2.7.5-alpha.21",
    "@kungfu-trader/kungfu-sdk": "^2.7.5-alpha.21"
  },
  "kungfuDependencies": {
    "IMS-kf": "v2.7.3"
  },
  "kungfuBuild": {
    "skipBuildPlatforms": [
      "macos"
    ],
    "cpp": {
      "target": "bind/python",
      "links": {
        "windows": [
          "kungfu",
          "IMSTradeAPI"
        ],
        "linux": [
          "kungfu",
          "IMSTradeAPI"
        ]
      }
    }
  },
  "resolutions": {
    "@kungfu-trader/kungfu-core": "^2.7.5-alpha.21",
    "@kungfu-trader/kungfu-cli": "^2.7.5-alpha.21",
    "@kungfu-trader/kungfu-sdk": "^2.7.5-alpha.21",
    "nanopop": "~2.3.0"
  },
  "kungfuConfig": {
    "key": "monit",
    "name": "远程监听",
    "config": {
      "td": {
        "type": "multi",
        "settings": [
          {
            "key": "account_id",
            "name": "monit.account_id",
            "type": "str",
            "tip": "monit.account_id_tip",
            "required": true,
            "primary": true
          },
          {
            "key": "remote_address",
            "name": "monit.remote_address",
            "type": "str",
            "tip": "monit.remote_address_tip",
            "required": true
          },
          {
            "key": "remote_group",
            "name": "monit.remote_group",
            "type": "str",
            "tip": "monit.remote_group_tip",
            "required": true
          },
          {
            "key": "remote_name",
            "name": "monit.remote_name",
            "type": "str",
            "tip": "monit.remote_name_tip",
            "required": true
          }
        ]
      }
    },
    "language": {
      "zh-CN": {
        "monit": "远程监听",
        "account_id": "账户 ID",
        "remote_address": "连接地址",
        "remote_group": "远端账户类型",
        "remote_name": "远端账号"
      },
      "en-US": {
        "monit": "monit",
        "account_id": "Account ID",
        "remote_address": "remote_address",
        "remote_group": "remote_group",
        "remote_name": "remote_name"
      }
    }
  }
}
