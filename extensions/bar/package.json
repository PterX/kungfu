              },
              {
                "value": "15",
                "label": "15minutes"
              }
              
            ],
            "errMsg": "xxx_mode_error",
            "required": true
          }
        ]
      }
    },
    "language": {
      "zh-CN": {
      },
      "en-US": {
      }
