{
  "name": "@kungfu-tech/kfx-matcher-101-cpp",
  "author": {
    "name": "Kungfu Trader",
    "email": "info@kungfu.link"
  },
  "version": "4.0.0-alpha.0",
  "description": "KungFu Matcher 101 - on quote",
  "license": "Apache-2.0",
  "main": "package.json",
  "repository": {
    "url": "https://github.com/kungfu-trader/kungfu.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "binary": {
    "module_name": "kfx-matcher-101",
    "module_path": "dist/KungfuMatcher101Cpp",
    "remote_path": "{module_name}/v{major}/v{version}",
    "package_name": "{module_name}-v{version}-{platform}-{arch}-{configuration}.tar.gz",
    "host": "https://prebuilt.libkungfu.cc"
  },
  "scripts": {
    "clean": "kfs extension clean",
    "build": "kfs extension build",
    "package": "kfs project package",
    "format": "node ../../framework/core/.gyp/run-format-cpp.js src",
    "install": "node -e \"require('@kungfu-tech/core').prebuilt('install')\""
  },
  "dependencies": {
    "@kungfu-tech/core": "workspace:*"
  },
  "devDependencies": {
    "@kungfu-tech/sdk": "workspace:*"
  },
  "kungfuConfig": {
    "key": "KungfuMatcher101Cpp",
    "name": "Matcher101Cpp"
  }
}
