# build-local.env.example — kungfu 本地构建环境配置模板(镜像/缓存 + 编译参数)
#
# kungfu 仓本身零 LAN / 镜像 / 机器参数耦合:开源者克隆即用官方上游与默认并发,不受任何
# 内网或本机配置影响。需要经局域网缓存 / CN 镜像加速,或按本机内存封顶编译并发时,复制本
# 模板到「用户全局」位置并填好你自己的值(可用 `kungfu-code config set <KEY> <VALUE>` 维护):
#
#   ./kungfu-code config init        # 从本模板派生到用户全局位置
#   ./kungfu-code config set FNM_NODE_DIST_MIRROR https://...   # 或直接编辑
#   ./kungfu-code config edit
#
# 位置:${XDG_CONFIG_HOME:-$HOME/.config}/kungfu/build-local.env
# 为什么放用户全局而非仓内:git worktree 是独立检出,仓内被 .gitignore 的文件不会出现在
# 各 worktree;放用户全局,主仓与所有 worktree 共用同一份,也天然在仓外、开源安全。
# kungfu-code 起手式会自动 source 它,再叠加可选的仓根 ./build-local.env(已 .gitignore)。
# 未配置任何项则一律走官方 / 默认上游与默认并发。下列均为可选,按需取消注释改成你的值。

# ── 镜像 / 缓存(各上游)──────────────────────────────────────────────────
# node 发行版(fnm 取)。官方默认 https://nodejs.org/dist/;CN 公网镜像或局域网缓存示例:
# export FNM_NODE_DIST_MIRROR="https://npmmirror.com/mirrors/node/"

# electron 二进制(@electron/get 取 ~120MB zip)。不要设 ELECTRON_CUSTOM_DIR。
# export ELECTRON_MIRROR="https://npmmirror.com/mirrors/electron/"

# yarn 自身分发(corepack 取)。末尾不要带斜杠(带斜杠会触发 //yarn 404)。
# export COREPACK_NPM_REGISTRY="https://registry.npmmirror.com"

# pypi simple index(uv 装 Python 依赖)。亦可改用 ~/.config/uv/uv.toml 的 index-url 代替。
# export UV_DEFAULT_INDEX="https://mirrors.aliyun.com/pypi/simple/"

# uv 下载 standalone CPython 解释器的镜像(仅一次性)。默认走 astral 官方上游。
# export UV_PYTHON_INSTALL_MIRROR="https://YOUR-CACHE-HOST/python-build-standalone/"

# ── 编译参数(按机封顶)──────────────────────────────────────────────────
# C/C++ 并行编译数。kungfu 开 -flto + 重模板,单路峰值约 2GB;大核机(如 32 线程)默认满
# 并行会撑爆内存换页 thrash。经验法则 jobs ≈ 可用内存GB / 2。不设则由 conan 默认(os.cpu_count)。
# export KUNGFU_BUILD_JOBS="12"

# ── 不经本文件、走各自用户全局配置的项(本仓亦不含)─────────────────────────
#  npm 包安装 registry + 私有 @scope registry / token  →  ~/.npmrc
#    例:registry=http://YOUR-CACHE-HOST:4873/  + @kungfu-tech:registry=...  + _authToken
#  conan remote(如局域网 ConanCenter 透明缓存)         →  ~/.conan2/remotes.json
#    例:conan remote add <name> http://YOUR-CACHE-HOST:8083/
