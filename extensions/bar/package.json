  "license": "Apache-2.0",
  "private": true,
  "scripts": {
    "clean": "kfs operator clean",
    "build": "kfs operator build",
    "package": "kfs operator package",
    "format": "node ../../framework/core/.gyp/run-format-cpp.js src"
  },
  "dependencies": {
    "@kungfu-trader/kungfu-core": "^2.5.0-alpha.13"
