{
  "name": "@kungfu-tech/artifact-kungfu",
  "homepage": "https://kungfu.tech",
  "author": {
    "name": "Kungfu",
    "email": "info@kungfu.link"
  },
  "version": "4.0.0-alpha.0",
  "description": "Kungfu Artifact",
  "license": "Apache-2.0",
  "private": true,
  "main": "dist/app/main.js",
  "kungfuCraft": {
    "productName": "Kungfu",
    "zipTargetEnable": {
      "mac": false,
      "win": false
    }
  },
  "scripts": {
    "build": "pnpm exec kfs craft build",
    "package": "pnpm exec kfs craft package",
    "clean": "pnpm exec kfs craft clean",
    "dev": "pnpm exec kfs craft dev --with-webpack",
    "app": "pnpm exec kfs craft dev",
    "cli": "pnpm exec kfs craft cli"
  },
  "dependencies": {
    "@kungfu-tech/kfx-broker-sim": "workspace:*",
    "@kungfu-tech/kfx-broker-xtp-demo": "workspace:*",
    "@kungfu-tech/kfx-indexer-live": "workspace:*",
    "@kungfu-tech/kfx-matcher-101-cpp": "workspace:*",
    "@kungfu-tech/kfx-operator-bar": "workspace:*",
    "@kungfu-tech/gui": "workspace:*",
    "@kungfu-tech/tui": "workspace:*",
    "@kungfu-tech/core": "workspace:*",
    "@kungfu-tech/sdk": "workspace:*"
  },
  "repository": {
    "url": "https://github.com/kungfu-systems/kungfu.git"
  }
}
