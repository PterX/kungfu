# cache-proxy.env.example — kungfu 构建链「本地缓存 / 镜像代理」配置模板
#
# kungfu 仓本身零 LAN / 镜像耦合:开源者克隆即用官方上游,不受任何内网配置影响。
# 需要经局域网缓存或 CN 镜像加速时,复制本模板到「用户全局」位置并填好你自己的地址:
#
#   mkdir -p "${XDG_CONFIG_HOME:-$HOME/.config}/kungfu"
#   cp cache-proxy.env.example "${XDG_CONFIG_HOME:-$HOME/.config}/kungfu/cache-proxy.env"
#   # 编辑填入你的缓存 / 镜像地址;内网多机同步这一个文件即可
#
# 为什么放用户全局而非仓内:git worktree 是独立检出,仓内被 .gitignore 的文件不会出现在
# 各 worktree;放用户全局位置,主仓与所有 worktree 共用同一份,也天然在仓外、开源安全。
# kungfu-code 起手式会自动 source 用户全局 cache-proxy.env,再叠加可选的仓根 ./cache-proxy.env
# (已 .gitignore)。未配置任何项则一律走官方 / 默认上游。
#
# 下列均为可选;按需取消注释并改成你自己的地址。本模板不含任何真实内网地址。

# node 发行版(fnm 取)。官方默认 https://nodejs.org/dist/。CN 公网镜像示例如下;
# 或指向你的局域网缓存,例如 http://YOUR-CACHE-HOST:8088/node/
# export FNM_NODE_DIST_MIRROR="https://npmmirror.com/mirrors/node/"

# electron 二进制(@electron/get 取 ~120MB zip)。不要设 ELECTRON_CUSTOM_DIR ——
# @electron/get 默认目录即 v<version>,正好匹配镜像布局 electron/v<ver>/electron-v<ver>-<plat>-<arch>.zip。
# export ELECTRON_MIRROR="https://npmmirror.com/mirrors/electron/"

# yarn 自身分发(corepack 取)。注意末尾不要带斜杠(带斜杠会触发 //yarn 404)。
# export COREPACK_NPM_REGISTRY="https://registry.npmmirror.com"

# pypi simple index(uv 装 Python 依赖)。uv 亦可改用 ~/.config/uv/uv.toml 的 index-url 代替本项。
# export UV_DEFAULT_INDEX="https://mirrors.aliyun.com/pypi/simple/"

# uv 下载 standalone CPython 解释器的镜像(仅一次性)。默认走 astral 官方上游。
# export UV_PYTHON_INSTALL_MIRROR="https://YOUR-CACHE-HOST/python-build-standalone/"

# ── 不经本文件、走用户全局配置的项(各机 ~ 下自配,本仓亦不含)─────────────────
#  npm 包安装 registry + 私有 @scope registry / token  →  ~/.npmrc
#    例:registry=http://YOUR-CACHE-HOST:4873/  + @kungfu-trader:registry=...  + _authToken
#  conan remote(如局域网 ConanCenter 透明缓存)         →  ~/.conan2/remotes.json
#    例:conan remote add <name> http://YOUR-CACHE-HOST:8083/   （ConanCenter 缓存代理）
